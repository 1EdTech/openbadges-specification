{
  "@context": {
    "@protected": true,
    "obas": "https://purl.imsglobal.org/spec/ob-assessment/v2p0/vocab#",
    "xsd": "https://www.w3.org/2001/XMLSchema#",

    "AssessmentResultDescription": "obas:AssessmentResultDescription",
    "Section": "obas:Section",
    "Artifact": "extensions:AssessmentExtensionArtifact",
    "Exam": "extensions:AssessmentExtensionExam",
    "ExternalQuestion": "extensions:AssessmentExtensionExternalQuestion",
    "FileQuestion": "extensions:AssessmentExtensionFileQuestion",
    "Performance": "extensions:AssessmentExtensionPerformance",
    "TextQuestion": "obas:TextQuestion",

    "assessmentEvaluation": { "@id": "obas:assessmentEvaluation" },
    "assessmentType": { "@id": "obas:assessmentType" },
    "assessmentExample": { "@id": "obas:assessmentExample" },
    "assessmentOutput": { "@id": "obas:assessmentOutput" },
    "evaluationMethod": { "@id": "obas:evaluationMethod" },
    "scoringMethodExampleDescription": {
      "@id": "obas:scoringMethodExampleDescription"
    },

    "hasGroupParticipation": {
      "@id": "obas:hasGroupParticipation",
      "@type": "xsd:boolean"
    },
    "hasGroupEvaluation": {
      "@id": "obas:hasGroupEvaluation",
      "@type": "xsd:boolean"
    },

    "sections": {
      "@id": "obas:sections",
      "@container": "@set"
    },
    "title": { "@id": "obas:title" },
    "required": {
      "@id": "obas:required",
      "@type": "xsd:boolean"
    },

    "questions": {
      "@id": "obas:questions",
      "@container": "@set"
    },
    "text": { "@id": "obas:text" },
    "characterLimit": {
      "@id": "obas:characterLimit",
      "@type": "xsd:nonNegativeInteger"
    },
    "wordLimit": {
      "@id": "obas:wordLimit",
      "@type": "xsd:nonNegativeInteger"
    }
  }
}